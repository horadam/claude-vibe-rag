# Embeddings (search) always use OpenAI, so this key is always needed,
# either here or typed into the chat UI's Model settings.
OPENAI_API_KEY=sk-...
# Only needed when answers or the eval judge use Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Which provider writes answers and grades evals: openai (default) or anthropic.
# LLM_PROVIDER=anthropic
# JUDGE_PROVIDER=anthropic       # defaults to LLM_PROVIDER

# Optional model overrides (defaults shown).
# ANTHROPIC_GENERATION_MODEL=claude-sonnet-4-6
# ANTHROPIC_JUDGE_MODEL=claude-opus-5-5
# OPENAI_GENERATION_MODEL=gpt-5-mini
# OPENAI_JUDGE_MODEL=gpt-5
